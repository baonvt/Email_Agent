# Copy to .env or use scripts/Initialize-LocalEnvironment.ps1 to generate local secrets.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SIGNING_KEY=
POSTGRES_PORT=5432
REDIS_PORT=6379
FRONTEND_ORIGIN=http://localhost:3000
# Enable after setting a SendGrid API key with Mail Send permission and a verified sender.
SENDGRID_DELIVERY_ENABLED=false
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Enable after creating a Google OAuth client of type Web application.
GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8080/api/mailboxes/gmail/callback
