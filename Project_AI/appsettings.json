{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "InboxAgent",
    "Audience": "InboxAgent.Web",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "AuthWeb": {
    "AllowedOrigins": ["http://localhost:3000"],
    "AllowInsecureCookiesForDevelopment": false,
    "SameSite": "Lax"
  },
  "Email": {
    "DeliveryEnabled": true,
    "ApiKey": "",
    "FromEmail": "",
    "FromName": "InboxAgent",
    "FrontendBaseUrl": "http://localhost:3000"
  },
  "Gmail": {
    "Enabled": false,
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUri": "http://localhost:8080/api/mailboxes/gmail/callback"
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
